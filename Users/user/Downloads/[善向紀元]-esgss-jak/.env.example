# Google Generative AI API Key
# IMPORTANT: DO NOT commit this file. Add .env to your .gitignore file.
API_KEY="YOUR_GOOGLE_API_KEY_HERE"

# Server port (optional, defaults to 3001)
# PORT=3001

# 萬能智庫相關配置
# Database
DB_PASSWORD=junaikeydb_secret

# Gemini AI (Google)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# OpenAI (for voice and enhanced features)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Security
ADMIN_SECRET=my_super_secret_token

# Cloudflare Tunnel
TUNNEL_TOKEN=YOUR_CLOUDFLARE_TUNNEL_TOKEN

# JunAiKey CLI (Optional)
JAK_API_URL=http://localhost:3000/api
JAK_ADMIN_SECRET=my_super_secret_token

# JWT Secret (for existing ESG system)
JWT_SECRET=default-jwt-secret
