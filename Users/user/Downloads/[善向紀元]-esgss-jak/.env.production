# Production Environment Variables for ESG Sunshine Universal System

# Automation Webhook URLs
MAKE_WEBHOOK_URL=https://hook.us1.make.com/your-make-webhook-url
BOOST_SPACE_WEBHOOK_URL=https://your-boost-space-instance.boost.space/api/webhooks/your-webhook-id

# AI Services (Optional - configure in Vercel dashboard for security)
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key

# Application Configuration
VITE_APP_ENV=production
VITE_APP_NAME=ESG Sunshine Universal System v2.0
VITE_APP_VERSION=0.1.0-beta

# Monitoring & Analytics (configure in Vercel)
# SENTRY_DSN=your-sentry-dsn
# ANALYTICS_ID=your-analytics-id

# Security
VITE_ENABLE_SECURITY=true
VITE_ENABLE_MONITORING=true