# ===========================================
# ESG Sunshine Universal System - 統一環境配置
# ===========================================
# 這個文件包含所有子系統共享的環境變數
# 複製此文件為 .env 並填入實際值

# ===========================================
# 系統基本配置
# ===========================================
NODE_ENV=production
COMPOSE_PROJECT_NAME=esg-universal-system

# ===========================================
# AI 服務配置 (所有子系統共享)
# ===========================================
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.7

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# 向後兼容
API_KEY=${GEMINI_API_KEY}

# ===========================================
# 資料庫配置
# ===========================================

# ESG 主資料庫
ESG_DB_HOST=esg-db
ESG_DB_PORT=5432
ESG_DB_NAME=esg_dashboard
ESG_DB_USER=esg_user
ESG_DB_PASSWORD=esg_password
DATABASE_URL=postgresql://${ESG_DB_USER}:${ESG_DB_PASSWORD}@${ESG_DB_HOST}:${ESG_DB_PORT}/${ESG_DB_NAME}

# JunAiKey 專用資料庫
JUNAIKEY_DB_HOST=junaikeydb-db
JUNAIKEY_DB_PORT=5432
JUNAIKEY_DB_NAME=junaikeydb_db
JUNAIKEY_DB_USER=junaikeydb_admin
JUNAIKEY_DB_PASSWORD=junaikeydb_secret
JUNAIKEY_DATABASE_URL=postgresql://${JUNAIKEY_DB_USER}:${JUNAIKEY_DB_PASSWORD}@${JUNAIKEY_DB_HOST}:${JUNAIKEY_DB_PORT}/${JUNAIKEY_DB_NAME}

# 向後兼容
DB_HOST=${ESG_DB_HOST}
DB_PORT=${ESG_DB_PORT}
DB_NAME=${ESG_DB_NAME}
DB_USER=${ESG_DB_USER}
DB_PASSWORD=${ESG_DB_PASSWORD}

# ===========================================
# 快取服務配置
# ===========================================
REDIS_HOST=esg-redis
REDIS_PORT=6379
REDIS_PASSWORD=esg_redis_password

JUNAIKEY_REDIS_HOST=junaikeydb-redis
JUNAIKEY_REDIS_PORT=6379

# ===========================================
# 認證與安全
# ===========================================
JWT_SECRET=esg-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# 管理員密鑰
ADMIN_SECRET=universal-admin-secret-token
JAK_ADMIN_SECRET=${ADMIN_SECRET}

# ===========================================
# 外部整合
# ===========================================
AITABLE_API_KEY=your-aitable-api-key
AITABLE_BASE_ID=your-aitable-base-id

STRAICO_API_KEY=your-straico-api-key
STRAICO_BASE_URL=https://api.straico.com

BOOSTSPACE_WEBHOOK_URL=https://your-instance.boost.space/api/webhooks/your-webhook-id
BOOSTSPACE_API_KEY=your-boostspace-api-key

# Cloudflare Tunnel (JunAiKey)
TUNNEL_TOKEN=your-cloudflare-tunnel-token

# ===========================================
# 應用程式設定
# ===========================================

# 服務端口配置
API_GATEWAY_PORT=80
ESG_FRONTEND_PORT=3000
ESG_BACKEND_PORT=3001
ESG_API_PORT=3002
JUNAIKEY_BACKEND_PORT=3003
SHANXIANG_BACKEND_PORT=3004
GRAFANA_PORT=3005

# CORS 設定
CORS_ORIGIN=*

# 速率限制
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15

# ===========================================
# 檔案上傳設定
# ===========================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx
UPLOAD_PATH=./uploads

# ===========================================
# 監控與日誌
# ===========================================
LOG_LEVEL=info
MONITORING_ENABLED=true
METRICS_INTERVAL=30000
METRICS_RETENTION=86400

# ===========================================
# 前端設定 (Vite)
# ===========================================
VITE_API_URL=http://localhost:${API_GATEWAY_PORT}
VITE_JUNAIKEY_URL=http://localhost:${API_GATEWAY_PORT}/junaikey
VITE_SHANXIANG_URL=http://localhost:${API_GATEWAY_PORT}/shanxiang
VITE_APP_NAME=ESG Sunshine Universal System
VITE_APP_VERSION=2.0.0

# ===========================================
# 學習平台設定
# ===========================================
MAX_LEARNING_USERS=1000
LEARNING_TIMEOUT=3600000
CONTENT_CACHE_TTL=3600

# ===========================================
# 功能標誌
# ===========================================
FEATURE_AI_INSIGHTS=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_REALTIME_COLLAB=true
FEATURE_PERSONALIZED_LEARNING=true
FEATURE_UNIVERSAL_INTEGRATION=true

# ===========================================
# 郵件設定 (可選)
# ===========================================
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@esgss.com

# ===========================================
# 開發環境設定
# ===========================================
# 取消註釋以下設定以啟用開發模式
# NODE_ENV=development
# VITE_API_URL=http://localhost:3001/api
# CORS_ORIGIN=http://localhost:3000